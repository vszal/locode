# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtualenvs
.venv/
venv/
env/

# Tooling / caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.claude/

# Local-only working docs (kept on disk, not published)

# OS
.DS_Store

# session resume notes (local only)
.claude_resume

# eval run artifacts: results.json is the record worth keeping (the regression
# gate diffs it); raw event logs and transcripts are bulky and per-run.
evals/results/*/events/
evals/results/*/stdout/
evals/results/*/workspaces/
evals/results/CONTAMINATED-*/
.agent_resume

# generated from the polyglot benchmark clone (Exercism content, not vendored)
evals/cases/polyglot-*/
# the shared jest toolchain for the JavaScript track: ~99 MB of node_modules,
# recreated by `python evals/polyglot.py --install-jsdeps`
evals/.jsdeps/
# aider, installed in its own venv for the harness-vs-harness comparison so
# it never enters this project's dependency set (evals/aider_compare.py)
evals/.aidervenv/
