{"seq": 8, "t": 6.566, "phase": "result", "name": "read_file", "error": false, "content": "     1\t#!/usr/bin/env python3\n     2\t\"\"\"Sync assets from the vendored upstream tree into ./local.\n     3\t\n     4\tReports every file that is new or changed upstream. Run with no arguments.\n     5\t\"\"\"\n     6\timport os\n     7\tfrom pathlib import Path\n     8\t\n     9\tSOURCE_ROOT = Path(\"./upstream\")\n    10\tSOURCE_PATH = \"shared/vendor/widgets\"\n    11\tLOCAL_DIR = Path(\"./local\")\n    12\t\n    13\t\n    14\tdef scan(root):\n    15\t    found = {}\n    16\t    for dirpath, _dirs, names in os.walk(root):\n    17\t        for n in names:\n    18\t            p = Path(dirpath) / n\n    19\t            found[str(p.relative_to(root))] = p.read_text()\n    20\t    return found\n    21\t\n    22\t\n    23\tdef main():\n    24\t    source = scan(SOURCE_ROOT / SOURCE_PATH)\n    25\t    local = scan(LOCAL_DIR)\n    26\t    changed = [n for n, body in source.items()\n    27\t               if n not in local or local[n] != body]\n    28\t    if not changed:\n    29\t        print(\"no differences\")\n    30\t        return\n    31\t    for n in sorted(changed):\n    32\t        print(\"differs:\", n)\n    33\t\n    34\t\n    35\tif __name__ == \"__main__\":\n    36\t    main()", "seconds": 0.0}
