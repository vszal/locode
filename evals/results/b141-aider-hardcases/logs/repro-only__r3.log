 def largest_charges(rows: list[dict], limit: int = TOP_N) -> list[dict]:       
     """The `limit` largest charges, biggest first."""                          
     ranked = sorted(rows, key=lambda row: row["amount"], reverse=True)         
     seen = set()                                                               
     result = []                                                                
     for row in ranked:                                                         
         if row["amount"] not in seen:                                          
             seen.add(row["amount"])                                            
             result.append(row)                                                 
             if len(result) >= limit:                                           
                 break                                                          
     return result                                                              
